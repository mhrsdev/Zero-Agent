[Unit]
Description=Zero OfficeCLI isolated worker
After=network-online.target zero-listener.service
ConditionPathExists=/usr/local/lib/zero-office/officecli

[Service]
Type=simple
User=zero
Group=zero
WorkingDirectory=/opt/zero
EnvironmentFile=-/opt/zero/runtime/office.env
ExecCondition=/opt/zero/.venv/bin/python /opt/zero/scripts/office_feature_enabled.py
ExecStart=/opt/zero/.venv/bin/python /opt/zero/scripts/run_office_worker.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateNetwork=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=read-only
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
RestrictAddressFamilies=AF_UNIX
SystemCallArchitectures=native
MemoryMax=1G
MemorySwapMax=0
CPUQuota=100%
TasksMax=256
RuntimeMaxSec=15min
ReadWritePaths=/opt/zero/runtime/state /opt/zero/runtime/office_jobs /opt/zero/runtime/office_ingest

[Install]
WantedBy=multi-user.target
